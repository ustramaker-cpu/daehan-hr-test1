node {
    stage('Clone repository') {
        checkout scm
        slackSend (channel: '#jenkins', color: '#00FF00', message: "Clone repository: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})")
    }

    stage('Environment') {
        sh 'chmod 755 ./gradlew'
    }

    stage('Ready') {
        sh "echo system deploy start"
    }

    stage('Build Jar') {
        sh './gradlew clean'
        sh './gradlew :ustra-hr-system-thymeleaf:bootJar'
        slackSend (channel: '#jenkins', color: '#00FF00', message: "Build SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})")
    }

    stage('Deploy - Was Restart') {
        sh './deploy.sh ustra-hr'
        slackSend (channel: '#jenkins', color: '#00FF00', message: "Deploy SUCCESSFUL: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})")
    }
}
